rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|jpg)')
        && request.resource.size <= 10 * 1024 * 1024; // 10MB limit
    }
    
    // 1. Global Default Deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
    
    // 2. Public Report Images (Readable by all, writable only by authenticated owner)
    match /uploads/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidImage();
      allow delete: if isOwner(userId);
    }
    
    // 3. User Avatar/Profile Assets
    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidImage();
      allow delete: if isOwner(userId);
    }
    
    // 4. Private Claim Dispute Evidence (Accessible only to claimant and owner)
    match /claims/{claimId}/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isValidImage();
      allow delete: if isOwner(userId);
    }
  }
}
